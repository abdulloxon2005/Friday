[Unit]
Description=FRIDAY Cyber AI Assistant & Gmail Hub
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/friday
ExecStart=/usr/bin/python3 gmail_server.py
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=friday-ai
Environment=PYTHONUNBUFFERED=1
Environment=PORT=5000
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
